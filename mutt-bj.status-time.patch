diff --git mutt-2.4.3.orig/menu.c mutt-2.4.3/menu.c
--- mutt-2.4.3.orig/menu.c
+++ mutt-2.4.3/menu.c
@@ -1283,3 +1283,23 @@ int mutt_menuLoop(MUTTMENU *menu)
   }
   /* not reached */
 }
+
+int update_status_time ()
+{
+  static time_t Last;
+  time_t now;
+
+  if (StatusUpdate < 0)
+    return 0;
+  else if (StatusUpdate == 0)
+    return 1;
+
+  now = time (NULL);
+  if (now - Last >= StatusUpdate)
+  {
+    Last = now;
+    return 1;
+  }
+  else
+    return 0;
+}
