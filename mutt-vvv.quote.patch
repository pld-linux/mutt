diff --git mutt-2.4.3.orig/PATCHES mutt-2.4.3/PATCHES
--- mutt-2.4.3.orig/PATCHES
+++ mutt-2.4.3/PATCHES
@@ -0,0 +1 @@
+vvv.quote
diff --git mutt-2.4.3.orig/handler.c mutt-2.4.3/handler.c
--- mutt-2.4.3.orig/handler.c
+++ mutt-2.4.3/handler.c
@@ -1603,7 +1603,31 @@ static int text_plain_handler(BODY *b, STATE *s)
         buf[--l] = 0;
     }
     if (s->prefix)
-      state_puts(s->prefix, s);
+    {
+      size_t i, j = 0, offset = 0;
+      regmatch_t pmatch[1];
+
+      while (regexec((regex_t *) QuoteRegexp.rx, &buf[offset], 1, pmatch, 0) == 0 &&
+             pmatch->rm_eo > 0)
+        offset += pmatch->rm_eo;
+
+      if (!option(OPTQUOTEEMPTY) && !*buf)
+        ;
+      else if (option(OPTQUOTEQUOTED) && offset)
+      {
+        /* repeat the last quote character of the existing prefix */
+        for (i = 0; i < offset; i++)
+          if (buf[i] != ' ')
+            j = i;
+        for (i = 0; i <= j; i++)
+          state_putc(buf[i], s);
+        state_puts(buf + j, s);
+        state_putc('\n', s);
+        continue;
+      }
+      else
+        state_puts(s->prefix, s);
+    }
     state_puts(buf, s);
     state_putc('\n', s);
   }
@@ -1806,7 +1830,7 @@ int mutt_body_handler(BODY *b, STATE *s)
        */
       if ((WithCrypto & APPLICATION_PGP) && mutt_is_application_pgp(b))
         encrypted_handler = handler = crypt_pgp_application_pgp_handler;
-      else if (option(OPTREFLOWTEXT) && ascii_strcasecmp("flowed", mutt_get_parameter("format", b->parameter)) == 0)
+      else if (option(OPTREFLOWTEXT) && ascii_strcasecmp("flowed", mutt_get_parameter("format", b->parameter)) == 0 && !s->prefix)
         handler = rfc3676_handler;
       else
         handler = text_plain_handler;
