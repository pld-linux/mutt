Add keep_to option to control where To: recipients are copied on group-reply (To: or Cc:).

author: Jan Palus

diff --git mutt-2.4.3.orig/init.h mutt-2.4.3/init.h
--- mutt-2.4.3.orig/init.h
+++ mutt-2.4.3/init.h
@@ -2023,6 +2023,12 @@ struct option_t MuttVars[] = {
   ** from your spool mailbox to your $$mbox mailbox, or as a result of
   ** a ``$mbox-hook'' command.
   */
+  { "keep_to", DT_BOOL, R_NONE, {.l=OPTKEEPTO}, {.l=0} },
+  /*
+  ** .pp
+  ** Controls where recipients from ``To:'' list go on group-reply. If \fIset\fP
+  ** they are copied to ``To:'' otherwise to ``Cc:''.
+  */
   { "local_date_header", DT_BOOL, R_NONE, {.l=OPTLOCALDATEHEADER}, {.l=1} },
   /*
   ** .pp
diff --git mutt-2.4.3.orig/mutt.h mutt-2.4.3/mutt.h
--- mutt-2.4.3.orig/mutt.h
+++ mutt-2.4.3/mutt.h
@@ -492,6 +492,7 @@ enum
   OPTINCLUDEENCRYPTED,
   OPTINCLUDEONLYFIRST,
   OPTKEEPFLAGGED,
+  OPTKEEPTO,
   OPTLOCALDATEHEADER,
   OPTMUTTLISPINLINEEVAL,
   OPTMAILCAPSANITIZE,
diff --git mutt-2.4.3.orig/send.c mutt-2.4.3/send.c
--- mutt-2.4.3.orig/send.c
+++ mutt-2.4.3/send.c
@@ -699,7 +699,7 @@ int mutt_fetch_recips(ENVELOPE *out, ENVELOPE *in, int flags)
         (!in->mail_followup_to || hmfupto != MUTT_YES))
     {
       /* if (!mutt_addr_is_user(in->to)) */
-      if (flags & SENDGROUPREPLY)
+      if ((flags & SENDGROUPREPLY) || !option(OPTKEEPTO))
         rfc822_append(&out->cc, in->to, 1);
       else
         rfc822_append(&out->to, in->to, 1);
